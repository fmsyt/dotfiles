// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "space e": "multi_workspace::ToggleWorkspaceSidebar",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "space y": ["workspace::SendKeystrokes", "\" + y"],
      "space g": "editor::ToggleComments",
    },
  },
  {
    "context": "Editor && vim_mode == normal && VimControl && !VimWaiting && !menu",
    "bindings": {
      "J": ["workspace::SendKeystrokes", "5 j"],
      "K": ["workspace::SendKeystrokes", "5 k"],
      "M":  "editor::Hover",
      "ctrl-/": "workspace::NewTerminal",
      "U": "vim::Redo",
      "space g g": "editor::ToggleComments",
      "H": "pane::ActivatePreviousItem",
      "L": "pane::ActivateNextItem",
      "s s": "pane::SplitHorizontal",
      "s v": "pane::SplitVertical",
      "ctrl-f h": ["workspace::SendKeystrokes",  "ctrl-w h"],
      "ctrl-f l": ["workspace::SendKeystrokes",  "ctrl-w l"],
      "ctrl-f j": ["workspace::SendKeystrokes",  "ctrl-w j"],
      "ctrl-f k": ["workspace::SendKeystrokes",  "ctrl-w k"],
      "space b d": "pane::CloseActiveItem",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-/": [
        "editor::ToggleComments",
        {
          "advance_downwards": false,
          "comment_empty_lines": true
        }
      ]
    }
  }
]
